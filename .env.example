# Only used for local testing of the Flask app (`python main.py`), NOT read
# by Cloud Run in production -- there these come from --set-env-vars and
# --set-secrets in deploy.sh instead.

TELEGRAM_BOT_TOKEN=
ALLOWED_TELEGRAM_USER_ID=
TIMEZONE=Europe/Amsterdam

# Random strings used to verify that incoming webhook calls really come from
# Telegram / Cloud Scheduler and not some random visitor of your public URL.
TELEGRAM_SECRET_TOKEN=
SCHEDULER_SHARED_SECRET=

# Leave PROJECT_ID empty locally to use Application Default Credentials'
# default project (run `gcloud auth application-default login` once).
PROJECT_ID=

# Point at a local tokenstore dir created by scripts/garmin_login_setup.py.
# In production this is GARMIN_TOKENS_B64 instead (set by deploy.sh).
GARMIN_TOKENSTORE=
