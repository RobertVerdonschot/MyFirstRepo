# Telegram bot token, from @BotFather
TELEGRAM_BOT_TOKEN=

# Your own numeric Telegram user id (get it from @userinfobot).
# The bot ignores messages from anyone else, so a stranger who finds
# your bot's username can't log fake meals or read your data.
ALLOWED_TELEGRAM_USER_ID=

# Only needed once, for scripts/garmin_login_setup.py. Not read by the bot
# itself at runtime -- after setup the bot only uses the saved token file.
GARMIN_EMAIL=
GARMIN_PASSWORD=

# IANA timezone used to interpret meal times and Garmin timestamps.
TIMEZONE=Europe/Amsterdam

# Paths (defaults are fine when running via docker-compose).
DB_PATH=/app/data/meals.db
GARMIN_TOKENSTORE=/app/data/garmin_tokens
